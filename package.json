{
  "name": "thread",
  "version": "0.0.0",
  "private": true,
  "description": "Session memory with lineage for coding agents",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "pnpm --filter @thread/core build && pnpm --filter @thread/evals build && node packages/evals/dist/eval-cli.js",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@thread/adapter-qoder-cli": "workspace:*",
    "@thread/core": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
